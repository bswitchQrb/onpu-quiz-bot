{
  "name": "onpu-quiz-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --test-scheduled",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "images": "tsx scripts/generate-images.ts",
    "register-commands": "tsx scripts/register-commands.ts",
    "db:migrate": "wrangler d1 migrations apply onpu-quiz-bot --remote"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vexflow": "^5.9.0",
    "vitest": "^5.1.1",
    "wawoff2": "^2.0.1",
    "wrangler": "^4.166.0"
  }
}
